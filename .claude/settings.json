{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Railway__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-railway-mutations.js\"",
            "statusMessage": "Checking Railway MCP call against the read-only allowlist"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-incident-narration.js\" 2>/dev/null || true",
            "statusMessage": "Checking for incident-narration in docs/comments"
          }
        ]
      }
    ]
  }
}
