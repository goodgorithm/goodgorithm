# Copy to .env for local dev. Real values live in Railway's environment
# variables (staging and prod configured separately there) - never commit
# actual secrets here or anywhere else in the repo.

# Postgres (Supabase) - use a separate project or branch for staging
# vs prod so schema changes can't accidentally hit production data.
DATABASE_URL=

# Redis (Upstash) - REST API, not the raw redis:// protocol.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis capacity guard (optional, defaults shown): byte cap (matching the
# current Upstash plan on both staging and production), the usage fraction
# that triggers proactive cleanup, how often it's checked, and the SCAN
# COUNT hint used while clearing. See the wiki's Configuration page.
REDIS_MAX_BYTES=1073741824
REDIS_SOFT_LIMIT_RATIO=0.85
REDIS_GUARD_INTERVAL_SECONDS=30
REDIS_GUARD_SCAN_COUNT=500

# Object storage (Cloudflare R2) - S3-compatible API credentials,
# generated under R2 -> Manage API Tokens in the Cloudflare dashboard.
# SENTIMENT_MODEL_VERSION/CATEGORY_MODEL_VERSION optionally pin a specific
# model version instead of resolving latest.json - see the wiki's
# Configuration page and the release-sentiment-model/release-category-
# classifier skills.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SENTIMENT_MODEL_VERSION=
CATEGORY_MODEL_VERSION=

# Bluesky Jetstream / Mastodon public timelines need no auth/keys -
# both are unauthenticated public endpoints, intentionally excluded here.
# The Bluesky moderation-service label stream (mod.bsky.app, content
# filter's Workstream B) is equally unauthenticated - no keys needed.

# Content filter kill switch (optional, unset = enabled). Disables just
# the Bluesky labeler-stream connection (blueskyLabels.ts) without
# touching the primary Jetstream/Mastodon ingestion paths - set this to
# anything to disable if the labels connection misbehaves in production,
# without needing a redeploy. The hashtag/self-label hard-excludes in
# processing/src/pipeline_stages/content_filter.py are not gated by this flag.
DISABLE_LABEL_FILTER=

# Bluesky ingestion sample rate (optional, default 1.0 = no throttling) and
# Jetstream/labels-stream reconnect backoff (optional, defaults shown). See
# the wiki's Configuration page for what these do and how to tune them.
BLUESKY_SAMPLE_RATE=1.0
BLUESKY_RECONNECT_BASE_MS=5000
BLUESKY_RECONNECT_MAX_MS=60000

# How long ingestion/'s pendingExclusions.ts remembers a moderation-label
# delete that found no matching row yet, in case the corresponding
# Jetstream insert is still in flight (optional, default shown). See issue
# #67 and the wiki's Configuration page.
BLUESKY_PENDING_EXCLUSION_TTL_MS=30000

# Which Bluesky global label values count as adult content (optional,
# defaults shown). Read independently by ingestion/'s blueskyLabels.ts and
# processing/'s content_filter.py - same name, but Railway doesn't share
# env vars across services, so set this in both services' variables to
# keep them in sync. See the wiki's Configuration page.
BLUESKY_ADULT_LABEL_VALUES=porn,sexual,graphic-media,nudity
BLUESKY_BOT_LABEL_VALUE=bot

# Mastodon instances polled, and poll cadence/timeout (optional, defaults
# shown = the current 8-instance list). See the wiki's Configuration and
# Mastodon pages before adding an instance - it needs to be individually
# vetted, not just popular.
MASTODON_INSTANCES=fosstodon.org,hachyderm.io,sciences.social,journa.host,universeodon.com,mstdn.social,mas.to,mastodon.world
MASTODON_POLL_INTERVAL_MS=30000
MASTODON_REQUEST_TIMEOUT_MS=10000

# Processing service (optional - defaults shown are used if unset). See the
# wiki's Configuration page for what each one does and how to tune it.
PROCESSING_BATCH_SIZE=500
PROCESSING_INTERVAL_SECONDS=300
PROCESSING_BACKLOG_BUFFER_SECONDS=3
REFRESH_RANKINGS_INTERVAL_SECONDS=30
NETWORK_DETECTION_INTERVAL_SECONDS=3600

# moderation_recheck.py's backstop sweep - batch size and throttle
# (optional, defaults shown). See issue #67 and the wiki's Configuration
# page for why this is throttled unlike purge_blocked_authors.
MODERATION_RECHECK_BATCH_SIZE=500
MODERATION_RECHECK_INTERVAL_SECONDS=10

# author_resolver.py's Bluesky author-name/avatar sweep - batch size and
# throttle (optional, defaults shown). Scoped to already-ranked posts
# only, and must run after REFRESH_RANKINGS_INTERVAL_SECONDS's stage in
# the same loop iteration. See issue #73 and the wiki's Configuration page.
AUTHOR_RESOLVE_BATCH_SIZE=500
AUTHOR_RESOLVE_INTERVAL_SECONDS=60

# Coordinated-network detection thresholds (optional, defaults shown =
# starting points, not empirically tuned yet). See the wiki's
# Configuration and Pipeline Internals pages.
NETWORK_DETECTOR_MIN_CLUSTER_ACCOUNTS=5
NETWORK_DETECTOR_MAX_ACCOUNT_CREATION_SPAN_DAYS=14
NETWORK_DETECTOR_MIN_CLUSTER_POST_COUNT=50

# Postgres connection pool + batched-write chunk sizes (optional, defaults
# shown). DB_POOL_MIN_SIZE must not exceed DB_POOL_MAX_SIZE - checked at
# startup. See the wiki's Configuration page.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_UPSERT_PROCESSED_POSTS_CHUNK_SIZE=500
DB_RANK_SCORE_UPDATE_CHUNK_SIZE=1000

# Language-ID model tuning (optional, defaults shown). MODEL_URL is
# deliberately not an env var -- a version pin baked into code, same as
# pyproject.toml's en_core_web_sm wheel URL. See the wiki's Configuration
# page.
LANGUAGE_FILTER_CONFIDENCE_THRESHOLD=0.3
LANGUAGE_FILTER_FETCH_TIMEOUT_SECONDS=30

# Ranking (MMR) tuning (optional, defaults shown = the current, not yet
# rigorously re-validated, configuration). RANKING_MMR_WINDOW_HOURS is
# deliberately wider than RETENTION_HOURS today -- see CLAUDE.md's Data
# retention section before changing. See the wiki's Ranking page.
RANKING_POSITIVITY_THRESHOLD=0.3
RANKING_HALF_LIFE_HOURS=12.0
RANKING_MMR_WINDOW_HOURS=72.0
RANKING_MMR_CANDIDATE_POOL_SIZE=2000
RANKING_MMR_LAMBDA=0.7
RANKING_SIMILARITY_TFIDF_WEIGHT=0.5
RANKING_SIMILARITY_ENTITY_WEIGHT=0.5

# Link-thumbnail resolution tuning (optional, defaults shown). USER_AGENT
# is deliberately not an env var -- a project identity string, not a
# tunable. See the wiki's Thumbnail Resolution page.
THUMBNAIL_RESOLVER_REQUEST_TIMEOUT_SECONDS=10
THUMBNAIL_RESOLVER_MAX_REDIRECTS=3
THUMBNAIL_RESOLVER_MAX_RESPONSE_BYTES=2097152

# HTTP timeout for every pipeline stage's calls to Bluesky's public AppView
# (getPosts) -- quote_resolver.py, moderation_recheck.py, author_resolver.py
# all share this one knob (util/bluesky_appview.py). APPVIEW_BASE/
# GET_POSTS_MAX_URIS are deliberately not env vars -- external protocol
# facts, not tunables. See the wiki's Configuration page.
APPVIEW_REQUEST_TIMEOUT_SECONDS=10

# base_score multiplier for a Bluesky reply to a different author -- kept
# in the feed but down-weighted, unlike Mastodon's equivalent cases which
# are excluded outright. See the wiki's Configuration page.
CONTEXT_DEPENDENCY_BLUESKY_DEVALUE_MULTIPLIER=0.4

# How long raw_posts/processed_posts are kept (optional, default shown).
# DEDUP_BAND_TTL_SECONDS below must be at least this many hours in seconds
# -- checked at startup. See the wiki's Configuration page.
RETENTION_HOURS=24

# Deduplication tuning (optional, defaults shown = the empirically-
# validated configuration). Treat any change as unvalidated until
# re-checked against real near-duplicate pairs. DEDUP_NUM_PERM must be
# evenly divisible by DEDUP_NUM_BANDS. DEDUP_BAND_TTL_SECONDS must be at
# least RETENTION_HOURS in seconds. See the wiki's Deduplication page.
DEDUP_NUM_PERM=128
DEDUP_NUM_BANDS=16
DEDUP_SHINGLE_SIZE=4
DEDUP_JACCARD_THRESHOLD=0.7
DEDUP_URL_JACCARD_THRESHOLD=0.2
DEDUP_BAND_TTL_SECONDS=86400

# Bot filter tuning (optional, defaults shown = the empirically-validated
# configuration). Treat any change as unvalidated until re-checked against
# real production data. The *_THRESHOLD vars must be at least 1 and the
# *_CAP vars must be greater than 0 (all are used as divisors). See the
# wiki's Bot Filter page.
BOT_FILTER_VELOCITY_WINDOW_SECONDS=3600
BOT_FILTER_VELOCITY_THRESHOLD=15
BOT_FILTER_SELF_DUP_TTL_SECONDS=86400
BOT_FILTER_URL_DENSITY_CAP=0.3
BOT_FILTER_HASHTAG_DENSITY_CAP=0.4
BOT_FILTER_CAPS_RATIO_CAP=0.6
BOT_FILTER_TEMPLATE_PREFIX_WORDS=3
BOT_FILTER_TEMPLATE_SUFFIX_WORDS=2
BOT_FILTER_TEMPLATE_REPEAT_TTL_SECONDS=86400
BOT_FILTER_TEMPLATE_REPEAT_THRESHOLD=5
BOT_FILTER_VELOCITY_WEIGHT=0.30
BOT_FILTER_SELF_DUP_WEIGHT=0.25
BOT_FILTER_LEXICAL_WEIGHT=0.20
BOT_FILTER_TEMPLATE_WEIGHT=0.25
BOT_FILTER_BOT_SCORE_THRESHOLD=0.5

# Topicality tuning (optional, defaults shown = the empirically-validated
# configuration). Treat any change as unvalidated until re-checked against
# a real production sample. TOPICALITY_TFIDF_TOP_K and
# TOPICALITY_BURST_THRESHOLD must each be at least 1. See the wiki's
# Topicality page.
TOPICALITY_TFIDF_TOP_K=3
TOPICALITY_LENGTH_NORM_ALPHA=0.3
TOPICALITY_BURST_THRESHOLD=5
TOPICALITY_BURST_BOOST_WEIGHT=1.0
TOPICALITY_BURST_TTL_SECONDS=10800
TOPICALITY_ENTITY_KEY_MAX_LEN=100
TOPICALITY_RELEVANT_ENTITY_LABELS=PERSON,ORG,GPE,LOC,FAC,EVENT,NORP,WORK_OF_ART

# Optional dead-man's-switch heartbeats (e.g. a Healthchecks.io check URL
# per service) - absence just means no heartbeat is sent, never blocks
# startup. processing/ pings once per fully successful cycle; ingestion/
# pings periodically (HEARTBEAT_INTERVAL_MS, optional, default shown),
# only if at least one post was inserted since the last check.
HEARTBEAT_URL_PROCESSING=
HEARTBEAT_PING_TIMEOUT_SECONDS=5
HEARTBEAT_URL_INGESTION=
HEARTBEAT_INTERVAL_MS=300000

# api/ service (optional except DATABASE_URL - defaults shown are used if
# unset). DB_POOL_MAX_SIZE is a separate, independent value from
# processing/'s own DB_POOL_MAX_SIZE above - same name, unrelated pools for
# unrelated services, no need to keep them matching. See the wiki's
# Configuration page.
PORT=3000
DB_POOL_MAX_SIZE=5
HEALTH_CHECK_TIMEOUT_MS=3000
FEED_LIMIT_MAX=100
FEED_LIMIT_DEFAULT=20
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Deployment commit SHA, reported by /health (both optional, "unknown" if
# neither is set - the normal case for local dev). Not meant to be set by
# hand: GIT_COMMIT_SHA is set by railway-deploy.sh, RAILWAY_GIT_COMMIT_SHA
# by Railway itself. See the wiki's Configuration page.
GIT_COMMIT_SHA=
RAILWAY_GIT_COMMIT_SHA=

# Web (Cloudflare Workers Static Assets) - baked in at build time, not a
# runtime var, since this is a static site with no server component of its
# own. See web/.env.example.
VITE_API_BASE_URL=http://localhost:3000
