# Copy to .env for local dev. Real values live in Railway's environment
# variables (staging and prod configured separately there) - never commit
# actual secrets here or anywhere else in the repo.

# Postgres (Supabase) - use a separate project or branch for staging
# vs prod so schema changes can't accidentally hit production data.
DATABASE_URL=

# Redis (Upstash) - REST API, not the raw redis:// protocol.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis capacity guard (optional, default shown = 1GB, matching the current
# Upstash plan cap on both staging and production). processing/ checks usage
# once per cycle and proactively clears expendable data (short-lived
# entity-burst counters, bot-filter self-dup tracking) once usage crosses
# 85% of this, instead of writing blind until Upstash rejects the write and
# crashes the process (see redis_guard.py; incident 2026-08-12).
REDIS_MAX_BYTES=1073741824

# Object storage (Cloudflare R2) - S3-compatible API credentials,
# generated under R2 -> Manage API Tokens in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Bluesky Jetstream / Mastodon public timelines need no auth/keys -
# both are unauthenticated public endpoints, intentionally excluded here.
# The Bluesky moderation-service label stream (mod.bsky.app, content
# filter's Workstream B) is equally unauthenticated - no keys needed.

# Content filter kill switch (optional, unset = enabled). Disables just
# the Bluesky labeler-stream connection (blueskyLabels.ts) without
# touching the primary Jetstream/Mastodon ingestion paths - set this to
# anything to disable if the labels connection misbehaves in production,
# without needing a redeploy. The hashtag/self-label hard-excludes in
# processing/src/content_filter.py are not gated by this flag.
DISABLE_LABEL_FILTER=

# Bluesky ingestion sample rate (optional, default 1.0 = no throttling) and
# Jetstream/labels-stream reconnect backoff (optional, defaults shown). See
# the wiki's Configuration page for what these do and how to tune them.
BLUESKY_SAMPLE_RATE=1.0
BLUESKY_RECONNECT_BASE_MS=5000
BLUESKY_RECONNECT_MAX_MS=60000

# Which Bluesky moderation-service label values blueskyLabels.ts acts on
# (optional, defaults shown). See the wiki's Configuration page - changing
# BLUESKY_ADULT_LABEL_VALUES also needs a matching manual update to
# processing/src/content_filter.py's hardcoded mirror of the same set.
BLUESKY_ADULT_LABEL_VALUES=porn,sexual,graphic-media,nudity
BLUESKY_BOT_LABEL_VALUE=bot

# Mastodon instances polled, and poll cadence/timeout (optional, defaults
# shown = the current 8-instance list). See the wiki's Configuration and
# Mastodon pages before adding an instance - it needs to be individually
# vetted, not just popular.
MASTODON_INSTANCES=fosstodon.org,hachyderm.io,sciences.social,journa.host,universeodon.com,mstdn.social,mas.to,mastodon.world
MASTODON_POLL_INTERVAL_MS=30000
MASTODON_REQUEST_TIMEOUT_MS=10000

# Processing service (optional - defaults shown are used if unset). See the
# wiki's Configuration page for what each one does and how to tune it.
PROCESSING_BATCH_SIZE=500
PROCESSING_INTERVAL_SECONDS=300
PROCESSING_BACKLOG_BUFFER_SECONDS=3
REFRESH_RANKINGS_INTERVAL_SECONDS=30
NETWORK_DETECTION_INTERVAL_SECONDS=3600
REDIS_GUARD_INTERVAL_SECONDS=30

# Optional dead-man's-switch heartbeats (e.g. a Healthchecks.io check URL
# per service) - absence just means no heartbeat is sent, never blocks
# startup. processing/ pings once per fully successful cycle; ingestion/
# pings periodically (HEARTBEAT_INTERVAL_MS, optional, default shown),
# only if at least one post was inserted since the last check.
HEARTBEAT_URL_PROCESSING=
HEARTBEAT_URL_INGESTION=
HEARTBEAT_INTERVAL_MS=300000

# Web (Cloudflare Workers Static Assets) - baked in at build time, not a
# runtime var, since this is a static site with no server component of its
# own. See web/.env.example.
VITE_API_BASE_URL=http://localhost:3000
