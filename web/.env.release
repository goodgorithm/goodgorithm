# Used by `npm run build:android` (vite build --mode release), the build
# that goes to the app stores. Points at the production api/ instance --
# the shipping app, and the fuller feed testers should see (staging runs
# at ~1% sample rate). Plain `npm run build`/`npm run dev` are unaffected
# and still use .env's localhost:3000; `build:native` still uses
# .env.staging. Committed, not a secret -- same public URL CI hardcodes in
# .github/workflows/ci.yml's deploy-web-production job.
VITE_API_BASE_URL=https://goodgorithm-api-production.up.railway.app
