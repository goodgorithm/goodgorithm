# Copy to .env for local dev. Points the frontend at a running api/ instance
# (e.g. `npm run dev` in ../api). Baked in at build time, not a runtime var -
# this is a static site with no server component of its own.
#
# Per-mode overrides (committed, not secret - all public URLs):
#   .env.staging  -> `npm run build:native`  (vite --mode staging)  : staging api
#   .env.release  -> `npm run build:android` (vite --mode release)  : production api, the store build
# Plain `npm run build` / `npm run dev` always use this .env (localhost).
VITE_API_BASE_URL=http://localhost:3000
